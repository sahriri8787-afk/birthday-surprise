  setTimeout(()=>success.classList.remove("show"),2600);
  launchCakeConfetti();
}

document.querySelectorAll("#interactiveCandles .real-candle").forEach(candle=>{
  candle.addEventListener("pointerdown",e=>{
    e.preventDefault();
    e.stopPropagation();
    if(candle.classList.contains("off"))return;

    candle.classList.add("off");

    const left=document.querySelectorAll("#interactiveCandles .real-candle:not(.off)").length;
    const hint=document.getElementById("cakeHint");

    if(left>0){
      hint.textContent=left===1 ? "فقط یه شمع دیگه مونده ✨" : `${left} تا شمع دیگه مونده ✨`;
    }else{
      cakeAllCandlesOff();
    }
  });
});

function spawnCakeCrumbs(stage,x,y){
  for(let i=0;i<12;i++){
    const c=document.createElement("i");
    c.className="cake-crumb";
    c.style.left=x+"px";
    c.style.top=y+"px";
    c.style.setProperty("--cx",((Math.random()-.3)*60)+"px");
    c.style.setProperty("--cy",((-15-Math.random()*55))+"px");
    c.style.setProperty("--cr",((Math.random()-.5)*500)+"deg");
    stage.appendChild(c);
    setTimeout(()=>c.remove(),800);
  }
}

function cutCakeFromDrag(clientX,clientY){
  if(cakeSliceDone || !cakeCandlesDone)return;

  cakeSliceDone=true;

  const stage=document.getElementById("interactiveCakeStage");
  const cake=document.getElementById("interactiveCakeImage");
  const slice=document.getElementById("cakeSlicePiece");
  const rect=stage.getBoundingClientRect();

  cake.src="assets/cake-interactive/cake-cut.png";
  cake.classList.remove("cut-pop");
  void cake.offsetWidth;
  cake.classList.add("cut-pop");

  slice.classList.add("out");

  spawnCakeCrumbs(
    stage,
    Math.max(20,Math.min(rect.width-20,clientX-rect.left)),
    Math.max(20,Math.min(rect.height-20,clientY-rect.top))
  );

  document.getElementById("cakeHint").textContent="برش کیک جدا شد 🍰";
  cakeCheckFinished();
}

const cakeStage=document.getElementById("interactiveCakeStage");

cakeStage.addEventListener("pointerdown",e=>{
  if(!cakeCandlesDone || cakeSliceDone)return;

  cakeDragStart={id:e.pointerId,x:e.clientX,y:e.clientY};
  cakeStage.setPointerCapture?.(e.pointerId);
  cakeStage.classList.add("dragging");
});

cakeStage.addEventListener("pointermove",e=>{
  if(!cakeDragStart || cakeSliceDone || !cakeCandlesDone)return;
  if(cakeDragStart.id!==e.pointerId)return;

  const dx=e.clientX-cakeDragStart.x;
  const dy=e.clientY-cakeDragStart.y;

  if(Math.hypot(dx,dy)>46){
    cutCakeFromDrag(e.clientX,e.clientY);
    cakeDragStart=null;
    cakeStage.classList.remove("dragging");
  }
});

function clearCakeDrag(){
  cakeDragStart=null;
  cakeStage.classList.remove("dragging");
}
cakeStage.addEventListener("pointerup",clearCakeDrag);
cakeStage.addEventListener("pointercancel",clearCakeDrag);
cakeStage.addEventListener("lostpointercapture",clearCakeDrag);


/* نامه */
