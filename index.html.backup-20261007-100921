let blown=false, streamRef=null, rafRef=null;
function launchConfetti(){
  const wrap=document.getElementById("confetti");
  wrap.innerHTML="";
  for(let i=0;i<42;i++){
    const el=document.createElement("i");
    el.className="confetti-piece fly";
    el.style.left=(8+Math.random()*84)+"%";
    el.style.setProperty("--x",((Math.random()-.5)*180)+"px");
    el.style.setProperty("--y",(160+Math.random()*420)+"px");
    el.style.setProperty("--r",((Math.random()-.5)*900)+"deg");
    el.style.background=["#fff","#6bc5ef","#ffd66b","#9b8cff","#ff8fa8"][i%5];
    el.style.animationDelay=(Math.random()*.28)+"s";
    wrap.appendChild(el);
  }
}
function blowCandles(){
  if(blown)return;
  blown=true;
  document.getElementById("candles").classList.add("blown");
  document.getElementById("micStatus").textContent="آرزوت رو نگه دار... ✨";
  launchConfetti();
  document.getElementById("cakeNext").classList.remove("hidden");
  if(streamRef) streamRef.getTracks().forEach(t=>t.stop());
  if(rafRef) cancelAnimationFrame(rafRef);
}
document.querySelector(".cake-wrap").onclick=blowCandles;
document.getElementById("micBtn").onclick=async()=>{
  const status=document.getElementById("micStatus");
  try{
    const stream=await navigator.mediaDevices.getUserMedia({audio:true});
    streamRef=stream;
    const AC=window.AudioContext||window.webkitAudioContext;
    const ctx=new AC(), src=ctx.createMediaStreamSource(stream), analyser=ctx.createAnalyser();
    analyser.fftSize=512; src.connect(analyser);
    const data=new Uint8Array(analyser.fftSize);
    let hit=0;
    const loop=()=>{
      analyser.getByteTimeDomainData(data);
      let sum=0;
      for(const v of data){const x=(v-128)/128;sum+=x*x}
      const rms=Math.sqrt(sum/data.length);
      status.textContent="فوت کن...";
      if(rms>.12) hit++; else hit=Math.max(0,hit-1);
      if(hit>5){blowCandles();return}
      rafRef=requestAnimationFrame(loop);
    };
    loop();
  }catch(e){
    status.textContent="دسترسی میکروفون فعال نشد؛ روی کیک بزن.";
  }
};

