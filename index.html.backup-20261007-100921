/* آهنگ اصلی + Lyrics Player سبک Spotify / ریتم زندگی */
let musicRAF=null,musicPlaying=false,lastLyricIndex=-2;
const cd=document.getElementById("cd");
const play=document.getElementById("musicPlay");
const musicAudio=document.getElementById("musicAudio");
const musicPlayLabel=document.getElementById("musicPlayLabel");
const lyricsViewport=document.getElementById("lyricsViewport");
const musicSeek=document.getElementById("musicSeek");
const musicCurrent=document.getElementById("musicCurrent");
const musicDuration=document.getElementById("musicDuration");
let lyricRows=[];

function fmtTime(sec){
  if(!Number.isFinite(sec)) return "0:00";
  sec=Math.max(0,Math.floor(sec));
  return `${Math.floor(sec/60)}:${String(sec%60).padStart(2,"0")}`;
}
function buildLyricsPlayer(){
  lyricsViewport.innerHTML='';
  const intro=document.createElement('div');
  intro.className='lyric-row lyric-intro';
  intro.dataset.index='-1';
  intro.innerHTML='<span class="lyric-start">Tap play to start...</span>';
  lyricsViewport.appendChild(intro);
  APP_CONFIG.lyrics.forEach((item,i)=>{
    if(!item.en) return;
    const row=document.createElement('div');
    row.className='lyric-row';
    row.dataset.index=String(i);
    row.innerHTML=item.en?`<span class="lyric-en">${item.en}</span>`:'';
    row.addEventListener('click',()=>{
      musicAudio.currentTime=Math.max(0,item.t+.02);
      renderLyricsByTime(musicAudio.currentTime,true);
    });
    lyricsViewport.appendChild(row);
  });
  lyricRows=[...lyricsViewport.querySelectorAll('.lyric-row')];
  setActiveLyric(-1,false);
}
function setActiveLyric(idx,smooth=true){
  lyricRows.forEach(row=>{
    const n=Number(row.dataset.index);
    row.classList.toggle('active',n===idx);
    row.classList.toggle('near',n!==idx && Math.abs(n-idx)<=1);
  });
  const target=lyricRows.find(row=>Number(row.dataset.index)===idx) || lyricRows[0];
  if(target){
    requestAnimationFrame(()=>target.scrollIntoView({behavior:smooth?'smooth':'auto',block:'center'}));
  }
}
function findLyricIndex(t){
  let lo=0,hi=APP_CONFIG.lyrics.length-1,idx=-1;
  while(lo<=hi){
    const mid=(lo+hi)>>1;
    if(APP_CONFIG.lyrics[mid].t<=t){idx=mid;lo=mid+1}else{hi=mid-1}
  }
  while(idx>=0 && !APP_CONFIG.lyrics[idx].en) idx--;
  return idx;
}
function renderLyricsByTime(t,force=false){
  const idx=findLyricIndex(t);
  if(force || idx!==lastLyricIndex){
    lastLyricIndex=idx;
    setActiveLyric(idx,true);
  }
}
function updateMusicProgress(){
  const duration=Number.isFinite(musicAudio.duration)?musicAudio.duration:177.293;
  const current=musicAudio.currentTime||0;
  musicSeek.value=duration>0?Math.round((current/duration)*1000):0;
  musicCurrent.textContent=fmtTime(current);
  musicDuration.textContent=fmtTime(duration);
}
function stopMusic(resetTime=false){
  if(musicRAF) cancelAnimationFrame(musicRAF);
  musicRAF=null;musicPlaying=false;musicAudio.pause();
  if(resetTime) musicAudio.currentTime=0;
  cd.classList.remove("playing");
  play.setAttribute("aria-label","پخش آهنگ");
  musicPlayLabel.textContent="پخش آهنگ";
  if(resetTime){lastLyricIndex=-2;setActiveLyric(-1,false);updateMusicProgress();}
}
function musicLoop(){
  renderLyricsByTime(musicAudio.currentTime||0);
  updateMusicProgress();
  if(!musicAudio.paused && !musicAudio.ended) musicRAF=requestAnimationFrame(musicLoop);
}
function resetMusic(){stopMusic(true)}
play.onclick=async()=>{
  if(musicPlaying){stopMusic(false);return}
  try{await musicAudio.play()}catch(e){}
};
musicSeek.addEventListener('input',()=>{
  const duration=Number.isFinite(musicAudio.duration)?musicAudio.duration:177.293;
  musicAudio.currentTime=(Number(musicSeek.value)/1000)*duration;
  renderLyricsByTime(musicAudio.currentTime,true);updateMusicProgress();
});
musicAudio.addEventListener('loadedmetadata',updateMusicProgress);
musicAudio.addEventListener("ended",()=>stopMusic(true));
musicAudio.addEventListener("pause",()=>{
  if(!musicAudio.ended){musicPlaying=false;cd.classList.remove("playing");play.setAttribute("aria-label","پخش آهنگ");musicPlayLabel.textContent="پخش آهنگ";if(musicRAF)cancelAnimationFrame(musicRAF);musicRAF=null;updateMusicProgress();}
});
musicAudio.addEventListener("play",()=>{
  musicPlaying=true;cd.classList.add("playing");play.setAttribute("aria-label","توقف آهنگ");musicPlayLabel.textContent="توقف آهنگ";if(musicRAF)cancelAnimationFrame(musicRAF);musicLoop();
});
