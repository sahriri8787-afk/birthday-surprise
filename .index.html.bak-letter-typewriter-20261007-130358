<script id="cakeEmergencyRuntimeV4">
(() => {
  "use strict";

  const forceCake = () => {
    const app = document.getElementById("app");
    const cake = document.getElementById("cake");
    if (!app || !cake) return false;

    app.classList.add("cake-emergency-mode");

    document.querySelectorAll(".screen").forEach((screen) => {
      if (screen !== cake) {
        screen.classList.remove("active");
        screen.setAttribute("aria-hidden", "true");
      }
    });

    cake.classList.add("active", "cake-emergency-active");
    cake.setAttribute("aria-hidden", "false");

    cake.style.setProperty("display", "block", "important");
    cake.style.setProperty("opacity", "1", "important");
    cake.style.setProperty("visibility", "visible", "important");
    cake.style.setProperty("transform", "none", "important");

    const ui = cake.querySelector(".cake-ui");
    const stage = cake.querySelector(".interactive-cake-stage");
    const image = cake.querySelector("#interactiveCakeImage");
    const candles = cake.querySelector("#interactiveCandles");

    [ui, stage, image, candles].forEach((el) => {
      if (!el) return;
      el.style.setProperty("opacity", "1", "important");
      el.style.setProperty("visibility", "visible", "important");
    });

    return true;
  };

  const leaveEmergencyCake = (targetId) => {
    const app = document.getElementById("app");
    const cake = document.getElementById("cake");
    const target = document.getElementById(targetId);
    if (!app || !cake || !target) return false;

    app.classList.remove("cake-emergency-mode");
    cake.classList.remove("active", "cake-emergency-active");

    document.querySelectorAll(".screen").forEach((screen) => {
      screen.classList.toggle("active", screen === target);
      screen.setAttribute("aria-hidden", screen === target ? "false" : "true");
    });

    return true;
  };

  const shouldOpenCake = () => {
    const params = new URLSearchParams(location.search);
    return params.get("screen") === "cake";
  };

  document.addEventListener("click", (event) => {
    const btn = event.target.closest("[data-go]");
    if (!btn) return;

    const targetId = btn.getAttribute("data-go");
    if (!targetId) return;

    if (targetId === "cake") {
      event.preventDefault();
      event.stopImmediatePropagation();
      forceCake();
      return;
    }

    if (
      document.getElementById("app")?.classList.contains("cake-emergency-mode")
      && targetId !== "cake"
    ) {
      event.preventDefault();
      event.stopImmediatePropagation();
      leaveEmergencyCake(targetId);
    }
  }, true);

  const boot = () => {
    if (shouldOpenCake()) {
      forceCake();
      let tries = 0;
      const timer = setInterval(() => {
        forceCake();
        tries += 1;
        if (tries >= 8) clearInterval(timer);
      }, 120);
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot, { once:true });
  } else {
    boot();
  }

  window.forceBirthdayCake = forceCake;
})();
</script>


<script id="cakePrettyRuntimeV5">
(() => {
  "use strict";

  const initPrettyCake = () => {
    const cake = document.getElementById("cake");
    const oldStage = document.getElementById("interactiveCakeStage");
    if (!cake || !oldStage) return false;

    cake.classList.add("pretty-v5");

    const title = cake.querySelector(".cake-title");
    const hint = cake.querySelector("#cakeHint");
    if (title) title.textContent = "یه آرزو کن 🎂";
    if (hint) hint.textContent = "شمع‌ها رو یکی‌یکی خاموش کن ✨";

    /* Clone the stage so all older conflicting pointer listeners are removed. */
    const stage = oldStage.cloneNode(true);
    oldStage.replaceWith(stage);

    const cakeImage = stage.querySelector("#interactiveCakeImage");
    const slice = stage.querySelector("#cakeSlicePiece");
    const candles = stage.querySelector("#interactiveCandles");
    const next = cake.querySelector("#cakeNext");
    const success = cake.querySelector("#cakeSuccess");

    if (!cakeImage || !slice || !candles) return false;

    cakeImage.src = "assets/cake-interactive/cake-full-sharp.png";
    slice.src = "assets/cake-interactive/cake-slice-clean.png";

    /* Add visual cut marker once. */
    let cutMark = stage.querySelector(".cake-cut-mark");
    if (!cutMark) {
      cutMark = document.createElement("div");
      cutMark.className = "cake-cut-mark";
      stage.appendChild(cutMark);
    }

    stage.classList.remove("served", "dragging");
    slice.classList.remove("out");
    candles.classList.remove("all-out");

    const candleEls = [...candles.querySelectorAll(".real-candle")];
    candleEls.forEach(c => c.classList.remove("off"));

    if (next) next.classList.add("hidden");

    let allOut = false;
    let served = false;
    let drag = null;

    const sparkle = () => {
      const wrap = cake.querySelector("#confetti");
      if (!wrap) return;

      wrap.innerHTML = "";
      for (let i = 0; i < 24; i++) {
        const el = document.createElement("i");
        el.className = "confetti-piece fly";
        el.style.left = (18 + Math.random() * 64) + "%";
        el.style.setProperty("--x", ((Math.random() - .5) * 125) + "px");
        el.style.setProperty("--y", (120 + Math.random() * 250) + "px");
        el.style.setProperty("--r", ((Math.random() - .5) * 620) + "deg");
        el.style.background = ["#fff","#8bd4ff","#b8a9ff","#ffd0e3","#ffe5a8"][i % 5];
        wrap.appendChild(el);
      }
    };

    const checkCandles = () => {
      const left = candleEls.filter(c => !c.classList.contains("off")).length;

      if (left > 0) {
        if (hint) {
          hint.textContent = left === 1
            ? "فقط یه شمع دیگه مونده ✨"
            : `${left} تا شمع دیگه مونده ✨`;
        }
        return;
      }

      if (allOut) return;
      allOut = true;

      if (hint) hint.textContent = "حالا روی کیک بکش تا برشش برداری 🍰";
      sparkle();

      setTimeout(() => {
        candles.classList.add("all-out");
      }, 420);

      if (success) {
        success.textContent = "حالا کیک رو بکش ✦";
        success.classList.add("show");
        setTimeout(() => success.classList.remove("show"), 1800);
      }
    };

    candleEls.forEach(candle => {
      candle.addEventListener("pointerdown", event => {
        event.preventDefault();
        event.stopPropagation();

        if (candle.classList.contains("off")) return;
        candle.classList.add("off");
        checkCandles();
      });
    });

    const finishSlice = () => {
      if (served || !allOut) return;
      served = true;

      stage.classList.remove("dragging");
      stage.classList.add("served");
      slice.classList.add("out");

      if (hint) hint.textContent = "این برش مال توئه ✨🍰";
      if (next) next.classList.remove("hidden");

      if (success) {
        success.textContent = "نوش جونت 🍰";
        success.classList.add("show");
        setTimeout(() => success.classList.remove("show"), 1800);
      }

      sparkle();
    };

    stage.addEventListener("pointerdown", event => {
      if (!allOut || served) return;

      drag = {
        id: event.pointerId,
        x: event.clientX,
        y: event.clientY
      };

      stage.classList.add("dragging");
      stage.setPointerCapture?.(event.pointerId);
    });

    stage.addEventListener("pointermove", event => {
      if (!drag || served || !allOut || drag.id !== event.pointerId) return;

      const dx = event.clientX - drag.x;
      const dy = event.clientY - drag.y;

      if (Math.hypot(dx, dy) > 48) {
        drag = null;
        finishSlice();
      }
    });

    const clearDrag = () => {
      drag = null;
      stage.classList.remove("dragging");
    };

    stage.addEventListener("pointerup", clearDrag);
    stage.addEventListener("pointercancel", clearDrag);
    stage.addEventListener("lostpointercapture", clearDrag);

    return true;
  };

  const boot = () => {
    const params = new URLSearchParams(location.search);
    if (params.get("screen") === "cake") {
      let tries = 0;
      const timer = setInterval(() => {
        const cake = document.getElementById("cake");
        if (cake?.classList.contains("cake-emergency-active")) {
          initPrettyCake();
          clearInterval(timer);
          return;
        }

        tries++;
        if (tries > 20) clearInterval(timer);
      }, 100);
    }
  };

  /* Re-initialize whenever the cake screen is opened via a data-go button. */
  document.addEventListener("click", event => {
    const btn = event.target.closest('[data-go="cake"]');
    if (!btn) return;

    setTimeout(() => {
      initPrettyCake();
    }, 80);
  }, true);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot, { once:true });
  } else {
    boot();
  }

  window.initPrettyBirthdayCake = initPrettyCake;
})();
</script>

<script id="letterVerticalRuntimeV1">
(() => {
  "use strict";
  const STORAGE_KEY = "birthday_letter_vertical_v1";

  function setupLetterV1(){
    const editor = document.getElementById("letterEditorV1");
    const state = document.getElementById("letterSaveStateV1");
    if(!editor || editor.dataset.ready === "1") return;
    editor.dataset.ready = "1";

    try{
      const saved = localStorage.getItem(STORAGE_KEY);
      if(saved !== null) editor.value = saved;
    }catch(_){}

    const fit = () => {
      editor.style.height = "auto";
      const min = Math.max(window.innerHeight - 330, 420);
      editor.style.height = Math.max(editor.scrollHeight, min) + "px";
    };

    let timer = 0;
    const save = () => {
      clearTimeout(timer);
      if(state){
        state.textContent = "در حال ذخیره...";
        state.classList.remove("saved");
      }
      timer = setTimeout(() => {
        try{ localStorage.setItem(STORAGE_KEY, editor.value); }catch(_){}
        if(state){
          state.textContent = "ذخیره شد ✓";
          state.classList.add("saved");
          setTimeout(() => {
            state.textContent = "خودکار ذخیره میشه ✦";
            state.classList.remove("saved");
          }, 1100);
        }
      }, 180);
    };

    editor.addEventListener("input", () => { fit(); save(); });
    window.addEventListener("resize", fit);
    fit();
  }

  document.addEventListener("click", e => {
    const btn = e.target.closest('[data-go="letter"]');
    if(!btn) return;
    setTimeout(setupLetterV1, 120);
  }, true);

  if(document.readyState === "loading"){
    document.addEventListener("DOMContentLoaded", setupLetterV1, {once:true});
  }else{
    setupLetterV1();
  }
  window.setupBirthdayLetterV1 = setupLetterV1;
})();
</script>
