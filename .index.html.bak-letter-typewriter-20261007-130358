function chime(){
  try{
    const AC = window.AudioContext || window.webkitAudioContext;
    const ctx = new AC();
    [523.25,659.25,783.99].forEach((f,i)=>{
      const o=ctx.createOscillator(),g=ctx.createGain();
      o.frequency.value=f;o.type="sine";
      g.gain.setValueAtTime(0,ctx.currentTime+i*.12);
      g.gain.linearRampToValueAtTime(.055,ctx.currentTime+i*.12+.03);
      g.gain.exponentialRampToValueAtTime(.001,ctx.currentTime+i*.12+.8);
      o.connect(g).connect(ctx.destination);
      o.start(ctx.currentTime+i*.12);o.stop(ctx.currentTime+i*.12+.85);
    });
  }catch(e){}
}
