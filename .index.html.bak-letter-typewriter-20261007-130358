<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="theme-color" content="#9ddcf8" />
<title>برای تو 💙</title>
<style>
:root{
  --sky:#9edcff;
  --sky2:#dff5ff;
  --sea:#3aa7d9;
  --deep:#0d4f7a;
  --ink:#17384d;
  --paper:#fffdf8;
  --blue:#4ea8de;
  --blue2:#84cfff;
  --glow:rgba(255,255,255,.88);
  --shadow:0 22px 70px rgba(8,54,87,.22);
}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#9edcff;font-family:Tahoma,Arial,sans-serif;color:var(--ink)}
@font-face{font-family:"AmiriLocal";src:url("assets/Amiri-Regular.ttf") format("truetype");font-weight:400;font-style:normal;font-display:swap}
button,input{font:inherit}
button{border:0;cursor:pointer}
#app{width:100%;height:100%;position:relative;overflow:hidden}
.screen{
  position:absolute;inset:0;display:grid;place-items:center;
  opacity:0;visibility:hidden;transform:scale(1.025);
  transition:opacity .85s ease,transform .85s cubic-bezier(.2,.8,.2,1),visibility .85s;
}
.screen.active{opacity:1;visibility:visible;transform:scale(1)}
.overlay{position:absolute;inset:0;pointer-events:none}
.soft-btn{
  padding:13px 24px;border-radius:999px;color:#fff;font-weight:700;
  background:linear-gradient(145deg,#72d5ff,#1689d1);backdrop-filter:blur(14px);
  box-shadow:0 12px 26px rgba(18,111,164,.25),inset 0 2px 3px rgba(255,255,255,.55),inset 0 -3px 7px rgba(0,72,125,.22);
  border:1px solid rgba(255,255,255,.55);
  transition:.2s transform,.2s filter,.2s box-shadow;
}
.soft-btn:hover{filter:brightness(1.06);box-shadow:0 15px 32px rgba(18,111,164,.3),inset 0 2px 3px rgba(255,255,255,.65),inset 0 -3px 7px rgba(0,72,125,.2)}
.soft-btn:active{transform:scale(.94) translateY(2px);filter:brightness(.98)}
.round-play{width:116px;height:116px;padding:0;border-radius:50%;background:url("assets/play-button-blue.png") center/cover no-repeat;box-shadow:0 15px 34px rgba(10,100,170,.3),0 0 0 5px rgba(255,255,255,.18);font-size:0;position:relative;overflow:hidden;display:inline-block}
.round-play:after{content:"";position:absolute;inset:8%;border-radius:50%;background:linear-gradient(135deg,rgba(255,255,255,.2),transparent 45%,rgba(0,93,170,.08));pointer-events:none}
.round-play:active{transform:scale(.91) translateY(3px)}
.round-label{display:block;margin-top:9px;font-weight:700;color:#fff;text-shadow:0 2px 10px rgba(10,75,105,.35)}
.nav-next{position:absolute;bottom:max(26px,env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);z-index:12}

.music-next-btn{
  left:16px;
  right:auto;
  bottom:max(16px,calc(env(safe-area-inset-bottom) + 10px));
  transform:none;
  z-index:18;
  display:flex;
  align-items:center;
  gap:9px;
  min-height:52px;
  padding:12px 18px 12px 14px;
  border-radius:24px 24px 24px 10px;
  background:
    linear-gradient(145deg,rgba(132,220,255,.97),rgba(30,144,224,.96) 58%,rgba(120,109,255,.95));
  color:#fff;
  box-shadow:
    0 16px 34px rgba(10,88,145,.34),
    0 0 24px rgba(130,210,255,.22),
    inset 0 2px 4px rgba(255,255,255,.55),
    inset 0 -4px 8px rgba(8,63,120,.20);
  border:1px solid rgba(255,255,255,.62);
  backdrop-filter:blur(12px);
  font-size:15px;
  letter-spacing:.1px;
}
.music-next-btn::before{
  content:"✦";
  width:26px;
  height:26px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:rgba(255,255,255,.18);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.28);
  font-size:15px;
  flex:0 0 auto;
}
.music-next-btn:hover{
  filter:brightness(1.07);
  box-shadow:
    0 20px 38px rgba(10,88,145,.40),
    0 0 28px rgba(130,210,255,.28),
    inset 0 2px 4px rgba(255,255,255,.62),
    inset 0 -4px 8px rgba(8,63,120,.20);
}
.music-next-btn:active{transform:translateY(2px) scale(.97)}
@media (max-width:420px){
  .music-next-btn{
    left:12px;
    bottom:max(12px,calc(env(safe-area-inset-bottom) + 8px));
    min-height:48px;
    padding:11px 16px 11px 13px;
    border-radius:22px 22px 22px 10px;
    font-size:14px;
  }
  .music-next-btn::before{width:24px;height:24px;font-size:14px}
}

/* 1. Ocean / exact splash artwork */
#ocean{
  background:#075fa5 url("assets/ocean-splash.png") center center / cover no-repeat;
  isolation:isolate;
}
.ocean-splash{
  position:absolute;inset:0;z-index:10;pointer-events:none;
  display:block;
}
.ocean-enter-hit{
  position:absolute;
  left:50%;top:53.2%;
  width:116px;height:116px;
  transform:translate(-50%,-50%);
  border:0;border-radius:50%;
  background:transparent;
  box-shadow:none;
  padding:0;
  cursor:pointer;
  -webkit-tap-highlight-color:transparent;
}
.ocean-enter-hit:focus-visible{
  outline:3px solid rgba(255,255,255,.85);
  outline-offset:7px;
}
@media (max-width:600px){
  .ocean-enter-hit{width:108px;height:108px;top:53.2%}
}
/* 2. Gift */
#gift{background:#061c48 url("assets/gift-background-final.jpg") center/cover no-repeat;isolation:isolate}
#gift:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 42%,rgba(77,194,255,.20),transparent 34%),linear-gradient(180deg,rgba(2,12,40,.10),rgba(1,8,30,.30));z-index:0;pointer-events:none}
.gift-stage{text-align:center;perspective:1000px;position:relative;z-index:3;width:min(92vw,520px);padding:24px 18px}
.gift-art{width:min(68vw,285px);max-height:285px;object-fit:contain;margin:4px auto 18px;display:block;filter:drop-shadow(0 18px 24px rgba(0,22,70,.40)) drop-shadow(0 0 28px rgba(71,202,255,.28));animation:giftFloat 3s ease-in-out infinite;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent;transition:filter .2s,transform .2s}
.gift-art:hover{filter:drop-shadow(0 20px 28px rgba(0,22,70,.46)) drop-shadow(0 0 38px rgba(71,202,255,.48))}
.gift-art:active{transform:scale(.94) translateY(3px)}
@keyframes giftFloat{50%{transform:translateY(-8px) rotate(1deg)}}
.gift-title{font-family:"AmiriLocal","Amiri","Noto Naskh Arabic",serif;color:#fff;text-shadow:0 3px 16px rgba(0,24,62,.65);font-size:clamp(34px,8.5vw,46px);font-weight:400;line-height:1.45;margin-bottom:24px}
.gift-hint{font-family:"AmiriLocal","Amiri","Noto Naskh Arabic",serif;color:rgba(255,255,255,.92);font-size:16px;text-shadow:0 2px 12px rgba(0,20,55,.75);margin-top:16px}
.gift-english{font-family:Georgia,"Times New Roman",serif;color:rgba(255,255,255,.96);font-size:clamp(18px,4.5vw,25px);font-weight:600;letter-spacing:.20em;text-transform:uppercase;text-shadow:0 2px 12px rgba(0,20,55,.62);margin-top:-15px;direction:ltr}
.gift-divider{display:flex;align-items:center;justify-content:center;gap:12px;margin:10px auto 22px;width:min(62vw,260px);direction:ltr}
.gift-divider span{height:1.5px;flex:1;background:rgba(255,255,255,.82);box-shadow:0 0 8px rgba(255,255,255,.28)}
.gift-divider b{font-family:Georgia,serif;color:#dff7ff;font-size:22px;line-height:1;text-shadow:0 0 12px rgba(113,219,255,.75);font-weight:400}
.gift-bubbles{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.gift-bubbles:before,.gift-bubbles:after{content:"";position:absolute;width:22px;height:22px;border:2px solid rgba(255,255,255,.55);border-radius:50%;left:18%;bottom:18%;animation:bubble 4s linear infinite}
.gift-bubbles:after{width:12px;height:12px;left:76%;bottom:12%;animation-delay:-1.7s}
@keyframes bubble{to{transform:translateY(-240px) scale(1.4);opacity:0}}

/* 3. Journal — full-screen, touch/swipe page turn */
#journal{background:#c8e9f8;overflow:hidden;touch-action:pan-y}
.journal-wrap{position:absolute;inset:0;width:100vw;height:100dvh;perspective:1800px;overflow:hidden}
.book{position:absolute;inset:0;width:100%;height:100%;transform-style:preserve-3d}
.page{position:absolute;inset:0;width:100%;height:100%;overflow:hidden;background:linear-gradient(145deg,#eefaff,#bfe4f5);transform-origin:left center;transition:transform .78s cubic-bezier(.2,.75,.18,1),opacity .55s;backface-visibility:hidden;box-shadow:0 0 35px rgba(15,91,125,.16)}
.page:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(61,92,120,.06),transparent 9%,transparent 91%,rgba(61,92,120,.04));pointer-events:none;z-index:3}
.page.flipped{transform:rotateY(-180deg);opacity:0;pointer-events:none}
.journal-template{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;z-index:1}
.journal-overlay{position:absolute;inset:0;z-index:4;pointer-events:none}
.page h2{font-family:Georgia,serif;font-size:clamp(28px,7vw,48px);margin:0 0 18px;color:#28698c}
.sticker{position:absolute;font-size:34px;transform:rotate(-8deg)}
.note{line-height:2.1;font-size:15px;max-width:78%}
.book-controls{
  position:fixed;
  top:max(14px,env(safe-area-inset-top));
  left:0;right:0;
  display:flex;
  justify-content:space-between;
  padding:0 18px;
  z-index:30;
  pointer-events:none;
}
.book-controls .soft-btn{
  pointer-events:auto;
  min-width:72px;
  min-height:40px;
  padding:8px 14px;
  font-size:13px;
  font-weight:700;
  color:#7a5561;
  background:linear-gradient(145deg,rgba(255,250,248,.95),rgba(244,228,233,.92));
  backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,.92);
  border-radius:22px;
  box-shadow:
    0 10px 24px rgba(120,92,98,.14),
    inset 0 2px 3px rgba(255,255,255,.9),
    inset 0 -3px 6px rgba(201,172,180,.18);
  text-shadow:0 1px 0 rgba(255,255,255,.8);
}
.book-controls .soft-btn:hover{
  filter:brightness(1.04);
}
.book-controls .soft-btn:active{
  transform:scale(.96) translateY(1px);
}
.book-controls .soft-btn:disabled{
  opacity:.42;
  filter:grayscale(.15);
}
#prevPage{
  border-radius:18px 24px 24px 24px;
}
#nextPage{
  border-radius:24px 18px 24px 24px;
}
@media (max-width:420px){
  .book-controls{
    padding:0 14px;
  }
  .book-controls .soft-btn{
    min-width:66px;
    min-height:38px;
    padding:7px 12px;
    font-size:12px;
  }
}
.journal-swipe-hint{position:fixed;left:50%;bottom:max(18px,env(safe-area-inset-bottom));transform:translateX(-50%);z-index:20;color:rgba(255,255,255,.92);font-size:13px;text-shadow:0 2px 8px rgba(0,55,90,.45);pointer-events:none;animation:hintFade 3.5s ease forwards}
@keyframes hintFade{0%,70%{opacity:1}100%{opacity:0}}

/* 4. Music — RytmZendegy x Spotify lyrics player */
#music{
  background:#020718 url("assets/music-stars-bg.jpg") center/cover no-repeat;
  color:white;isolation:isolate;overflow:hidden;
}
#music:before{
  content:"";position:absolute;inset:0;
  background:radial-gradient(circle at 50% 27%,rgba(132,218,255,.22),transparent 29%),linear-gradient(180deg,rgba(0,5,26,.24),rgba(0,5,22,.72));
  z-index:0;pointer-events:none;
}
.music-sparkles,.music-sparkles i{position:absolute;inset:0;pointer-events:none}
.music-sparkles{z-index:1;overflow:hidden}
.music-sparkles i{inset:auto;width:8px;height:8px;border-radius:50%;background:radial-gradient(circle,#fff 0 28%,rgba(197,235,255,.95) 30% 60%,transparent 68%);box-shadow:0 0 10px rgba(255,255,255,.9),0 0 22px rgba(120,205,255,.75);animation:twinkle var(--d,3s) ease-in-out infinite;opacity:.85;transform:scale(var(--s,1))}
.music-sparkles i:before,.music-sparkles i:after{content:"";position:absolute;left:50%;top:50%;background:rgba(255,255,255,.86);transform:translate(-50%,-50%);border-radius:999px}
.music-sparkles i:before{width:1.5px;height:20px;box-shadow:0 0 12px rgba(160,230,255,.65)}
.music-sparkles i:after{width:20px;height:1.5px;box-shadow:0 0 12px rgba(160,230,255,.65)}
@keyframes twinkle{0%,100%{opacity:.28;transform:scale(.7)}50%{opacity:1;transform:scale(1.16)}}
.music-card{width:min(94vw,620px);height:calc(100dvh - 72px);text-align:center;position:relative;z-index:3;padding:max(10px,env(safe-area-inset-top)) 10px 82px;display:flex;flex-direction:column;align-items:center;gap:5px}
.music-top{display:flex;align-items:center;justify-content:center;gap:14px;width:100%;flex:0 0 auto}
.cd{width:clamp(105px,28vw,158px);height:clamp(105px,28vw,158px);border-radius:50%;margin:0;position:relative;overflow:hidden;background:#071524 url("assets/cd-jellyfish.jpg") center/135% no-repeat;box-shadow:0 0 0 5px rgba(255,255,255,.10),0 0 45px rgba(116,210,255,.38),inset 0 0 32px rgba(0,0,0,.42);isolation:isolate;flex:0 0 auto}
.cd:before{content:"";position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 28% 20%,rgba(255,255,255,.65),transparent 12%),conic-gradient(from 20deg,transparent 0 72%,rgba(255,255,255,.3) 78%,transparent 84% 100%);mix-blend-mode:screen;opacity:.65;animation:shine 3.2s linear infinite}
.cd:after{content:"";position:absolute;left:50%;top:50%;width:22%;height:22%;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,#05090f 0 28%,#a9d8ee 30% 34%,#132a3b 36% 100%);box-shadow:0 0 0 3px rgba(255,255,255,.22),0 0 22px rgba(145,224,255,.5);z-index:2}
.cd.playing{animation:spin 5s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes shine{to{transform:rotate(360deg)}}
.cd.paused{animation-play-state:paused}
.music-heading{text-align:right;min-width:0}
.music-title{margin:0 0 4px;font-size:clamp(23px,5.7vw,36px);text-shadow:0 0 14px rgba(205,239,255,.55),0 0 28px rgba(122,211,255,.35)}
.music-subtitle{margin:0;color:rgba(230,245,255,.85);font-size:13px;direction:ltr;text-align:left;text-shadow:0 0 10px rgba(130,205,255,.45)}
.lyrics-player{position:relative;width:100%;flex:1 1 auto;min-height:0;margin-top:4px;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);overflow:hidden}
.lyrics-viewport{height:100%;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:none;padding:42% 14px 46%;scroll-behavior:smooth;mask-image:linear-gradient(to bottom,transparent 0,#000 14%,#000 86%,transparent 100%);-webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 14%,#000 86%,transparent 100%)}
.lyrics-viewport::-webkit-scrollbar{display:none}
.lyric-row{width:min(89vw,560px);margin:0 auto 20px;padding:4px 8px;opacity:.26;transform:scale(.96);filter:saturate(.8);transition:opacity .06s linear,transform .10s ease,filter .06s linear;cursor:pointer;-webkit-tap-highlight-color:transparent}
.lyric-row.near{opacity:.55;transform:scale(.985)}
.lyric-row.active{opacity:1;transform:scale(1.035);filter:none}
.lyric-en,.lyric-fa,.lyric-start{display:block}
.lyric-en{direction:ltr;text-align:center;font-size:clamp(20px,5.5vw,30px);font-weight:750;line-height:1.5;color:rgba(241,249,255,.92);text-shadow:0 0 8px rgba(255,255,255,.22)}
.lyric-fa{direction:rtl;text-align:center;margin-top:5px;font-size:clamp(17px,4.8vw,25px);font-weight:600;line-height:1.65;color:rgba(233,246,255,.88);text-shadow:0 0 9px rgba(113,205,255,.25)}
.lyric-row.active .lyric-en,.lyric-row.active .lyric-fa{color:#fff;text-shadow:0 0 7px #fff,0 0 17px #8edcff,0 0 32px rgba(102,203,255,.85);animation:textShine 2.6s linear infinite}
.lyric-row.active .lyric-fa{animation-direction:reverse}
.lyric-start{font-size:clamp(17px,4.8vw,25px);line-height:1.8;color:#fff;text-shadow:0 0 8px #fff,0 0 18px #79d4ff}
@keyframes textShine{0%{filter:brightness(.95)}50%{filter:brightness(1.22)}100%{filter:brightness(.95)}}
.music-controls{width:min(90vw,560px);flex:0 0 auto;padding-top:4px}
.music-progress{display:grid;grid-template-columns:42px 1fr 42px;align-items:center;gap:8px;font-size:11px;color:rgba(238,248,255,.72);direction:ltr}
.music-progress input{width:100%;accent-color:#fff;height:4px}
.music-play-row{display:flex;justify-content:center;align-items:center;gap:10px;margin-top:6px}
.music-play-row .round-play{width:66px;height:66px}
.music-play-row .round-label{margin:0;min-width:72px;text-align:right;font-size:13px}
@media (max-height:720px){
  .music-card{height:100dvh;padding-top:7px;padding-bottom:68px}
  .cd{width:94px;height:94px}
  .music-title{font-size:22px}.music-subtitle{font-size:11px}
  .lyric-row{margin-bottom:14px}.lyric-en{font-size:16px}.lyric-fa{font-size:16px}
  .music-play-row .round-play{width:56px;height:56px}
}

/* 5. Cards */
#prediction{background:linear-gradient(155deg,#edfaff,#afdff6)}
.pred-wrap{width:min(94vw,900px);text-align:center}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:24px}
.pred-card{aspect-ratio:3/4;perspective:900px;min-width:0}
.pred-inner{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:.8s;cursor:pointer}
.pred-card.open .pred-inner{transform:rotateY(180deg)}
.front,.back{position:absolute;inset:0;border-radius:18px;backface-visibility:hidden;display:grid;place-items:center;box-shadow:0 12px 28px rgba(23,85,117,.16);overflow:hidden}
.front{background:linear-gradient(145deg,#3a8ec0,#184d73);color:white;font-size:30px;border:1px solid rgba(255,255,255,.55)}
.back{background:#fff;transform:rotateY(180deg);padding:10px;color:#245b7d}
.back .card-img{width:100%;height:72%;border-radius:12px;background:linear-gradient(135deg,#e9f8ff,#b5ddf2);display:grid;place-items:center;font-size:38px}
.back .typing{font-size:13px;min-height:42px;display:grid;place-items:center}
.pred-bear{width:54%;max-height:42%;object-fit:contain;opacity:.95;filter:drop-shadow(0 8px 12px rgba(34,87,112,.15));animation:bearPeek 2.4s ease-in-out infinite}
@keyframes bearPeek{50%{transform:translateY(-5px) rotate(2deg)}}

/* 6. Timeline */
#timeline{background:linear-gradient(#f1fbff,#ccecf8)}
.timeline-shell{width:min(94vw,820px);height:78vh;overflow:auto;padding:24px 14px 110px;scrollbar-width:none}
.timeline-shell::-webkit-scrollbar{display:none}
.timeline-title{text-align:center;position:sticky;top:0;z-index:2;padding:12px;background:linear-gradient(rgba(241,251,255,.95),rgba(241,251,255,.55),transparent)}
.memory{display:grid;grid-template-columns:1fr 80px 1fr;align-items:center;margin:20px 0}
.memory:nth-child(even) .mem-card{grid-column:3}
.memory:nth-child(odd) .mem-card{grid-column:1}
.mem-card{background:#fff;border-radius:22px;padding:14px;box-shadow:0 12px 30px rgba(32,91,120,.12);transform:rotate(var(--r))}
.mem-photo{height:170px;border-radius:15px;background:linear-gradient(135deg,#cfefff,#97cae3);display:grid;place-items:center;font-size:38px}
.year{grid-column:2;grid-row:1;background:#4da4d3;color:#fff;width:64px;height:64px;border-radius:50%;display:grid;place-items:center;margin:auto;box-shadow:0 0 0 8px rgba(77,164,211,.12)}
.time-line{position:absolute;top:130px;bottom:90px;left:50%;width:3px;background:linear-gradient(#5caed7,#a7d9ef);transform:translateX(-50%)}

/* 7. Cake */
#cake{background:radial-gradient(circle at 50% 30%,#f6fdff,#a8d8ef)}
.cake-stage{text-align:center}
.cake-wrap{position:relative;width:300px;height:280px;margin:auto}
.cake-body{position:absolute;width:240px;height:110px;left:30px;bottom:32px;border-radius:26px 26px 38px 38px;background:linear-gradient(#fff,#dff4ff);box-shadow:0 20px 42px rgba(28,82,113,.18)}
.icing{position:absolute;width:240px;height:38px;left:30px;bottom:116px;border-radius:50%;background:#82cbed}
.candle-row{position:absolute;left:62px;right:62px;bottom:146px;display:flex;justify-content:space-between}
.candle{width:13px;height:52px;border-radius:4px;background:repeating-linear-gradient(45deg,#5aaed9 0 8px,#fff 8px 16px);position:relative}
.flame{position:absolute;width:17px;height:27px;left:-2px;top:-29px;border-radius:50% 50% 45% 45%;background:radial-gradient(circle at 50% 65%,#fff 0 12%,#ffd45c 16% 44%,#ff8b38 45% 70%,transparent 72%);filter:drop-shadow(0 0 10px #ffce5c);animation:flicker .2s infinite alternate;transform-origin:50% 100%}
@keyframes flicker{to{transform:rotate(4deg) scale(.94)}}
.blown .flame{animation:out .45s forwards}
@keyframes out{to{opacity:0;transform:translateY(-14px) scale(.2)}}
.mic-status{font-size:13px;opacity:.7;min-height:22px}
.confetti{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:5}.confetti-piece{position:absolute;top:-18px;width:8px;height:16px;border-radius:2px;opacity:0}.confetti-piece.fly{animation:confettiFall 1.8s cubic-bezier(.15,.8,.3,1) forwards}@keyframes confettiFall{0%{opacity:1;transform:translate3d(0,-20px,0) rotate(0)}100%{opacity:0;transform:translate3d(var(--x),var(--y),0) rotate(var(--r))}}

/* 8. Letter */
